# ── Required ─────────────────────────────────────────────────────
# Company Atlas connection (same value the backend uses as MONGODB_URI_NEW)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/BPIN?retryWrites=true&w=majority

# Read access to the private Vercel Blob store (same token as the backend)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Random string, 16+ chars. Vercel sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" on every cron invocation.
# Generate with: openssl rand -hex 24
CRON_SECRET=change-me-to-a-long-random-string

# Service-account key — the JSON file downloaded from the service account's
# "Keys → Add key → Create new key → JSON" in Google Cloud. Three ways to provide it:
#   1. paste the whole JSON on one line here:   GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#   2. base64 of that file:                     GOOGLE_SERVICE_ACCOUNT_JSON=$(base64 -i key.json | tr -d '\n')
#   3. point at the file:                       GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/key.json
# ...or simply save the downloaded file as ./service-account.json (gitignored, auto-detected).
GOOGLE_SERVICE_ACCOUNT_JSON=

# The Shared Drive (Google Workspace) that receives the backups. The service
# account above must be a member with "Content manager" access.
# The ID is the last part of the drive URL: drive.google.com/drive/folders/<THIS_PART>
# Both variables are optional individually — when both are set they are
# cross-checked; when only one is set the other is discovered automatically.
SHARED_DRIVE_ID=0Axxxxxxxxxxxxxxxxx
SHARED_DRIVE_NAME=BPIN_Backups

# ── Optional ─────────────────────────────────────────────────────
# Folder inside the Shared Drive that holds all backups
DRIVE_ROOT_FOLDER_NAME=BPIN CRM Backups

# Seconds of work per /api/work tick (function limit is 800s on Vercel Pro)
BACKUP_TIME_BUDGET_SECONDS=660

# How many fully-verified backups to keep before deleting the oldest
BACKUP_KEEP=2

# Diagnostics only — shorten retry cycles to drill failure handling locally:
# BACKUP_WAVE_COOLDOWN_SECONDS=900      # wait between retry waves (default 15 min)
# BACKUP_MAX_ITEM_WAVES=5               # waves before an item is failed
# BACKUP_RUN_RETRY_COOLDOWN_SECONDS=21600  # wait between automatic run retries (default 6h)

# Dev only: mirror "Drive" output into a local folder instead of Google Drive.
# When set, the Google credentials above are not required.
# DRIVE_LOCAL_DIR=./.drive-local

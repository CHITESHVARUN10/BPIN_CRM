# Vercel / production env template for the BPIN frontend.
# Vercel reads the values from the DASHBOARD (Settings → Environment Variables),
# not from a .env file — this file just documents what the app looks at.
#
# ─────────────────────────────────────────────────────────────────
# Base URL of the backend API. Unset = relative '/api' (dev proxy or
# same-origin serving). When the frontend is hosted on Vercel and the
# backend on Render, point it at the Render deployment:
#
VITE_API_URL=https://bpin-crm.onrender.com/api
#
# Notes:
#  - VITE_* variables are baked in at BUILD time — after changing them
#    in the Vercel dashboard, redeploy (Vercel shows a Redeploy prompt).
#  - No other VITE_ variables exist in this app.

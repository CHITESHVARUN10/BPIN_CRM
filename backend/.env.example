PORT=5000
NODE_ENV=production
# MongoDB — the company Atlas cluster. This is the only production connection
# string the backend reads. DB_URL is the optional local-development fallback.
MONGODB_URI_NEW=mongodb+srv://<user>:<password>@<company-cluster>.mongodb.net/BPIN?retryWrites=true&w=majority
# DB_URL=mongodb://127.0.0.1:27017/bpin
# Per-instance pool cap. Keep this small on Vercel so many function
# instances do not exhaust the Atlas connection limit.
MONGO_MAX_POOL_SIZE=10
# MONGODB_CONNECT_RETRIES=3
SESSION_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# Cross-origin frontend (Vercel) allowed with credentials, comma-separated
CLIENT_ORIGINS=
# "lax" is best when the frontend proxies /api on the same origin.
# Use "none" only when the browser calls the API domain directly.
COOKIE_SAMESITE=lax

# Vercel Blob — private store read/write token. Needed for direct browser
# uploads (the backend only issues upload tokens) and for streaming /api/files.
# Same value on every environment sharing the store.
BLOB_READ_WRITE_TOKEN=

# Real Web Push delivery — generate once with the web-push library.
# These two values must MATCH between every environment that shares subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@blaupunktcar.in

# ── Seeding (optional; initial/local setup only) ─────────────────────
# Run with `npm run seed`. Seeding never grants or revokes super-admin
# rights — that flag is managed directly in MongoDB. If ADMIN_PASSWORD or
# TECH_DEFAULT_PASSWORD are not set, the seed prints random one-off passwords.
# ADMIN_PASSWORD=
# TECH_DEFAULT_PASSWORD=

# ── Backup recovery (Super Admin only) ───────────────────────────────
# Google Drive access — use the same service account as backup-cron.
# The key can be provided inline, as base64, as a file path, or as
# ./service-account.json (gitignored, auto-detected).
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
SHARED_DRIVE_ID=
SHARED_DRIVE_NAME=
DRIVE_ROOT_FOLDER_NAME=BPIN CRM Backups
# Minutes of inactivity before recovery re-authentication is required again
RECOVERY_SESSION_TTL_MINUTES=15
# Maximum size (MB) of a single media asset the recovery will restore
RECOVERY_MAX_ASSET_MB=100
# Test/dev only — local mirrors so destructive drills never touch production
# DRIVE_LOCAL_DIR=
# BLOB_LOCAL_DIR=
# RECOVERY_TEST_FAULTS=

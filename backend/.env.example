PORT=5000
NODE_ENV=production
# MongoDB — MONGODB_URI_NEW (company Atlas) takes precedence; the legacy
# Atlas vars are kept only as fallbacks for older environments.
MONGODB_URI_NEW=mongodb+srv://<user>:<password>@<company-cluster>.mongodb.net/BPIN?retryWrites=true&w=majority
mongo_uri_txt=
DB_URL=mongodb://127.0.0.1:27017/bpin
SESSION_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# Cross-origin frontend (Vercel) allowed with credentials, comma-separated
CLIENT_ORIGINS=
# Session cookie SameSite (none for the Vercel frontend + separate API)
COOKIE_SAMESITE=none

# Vercel Blob — private store read/write token (required for photo/video upload)
# Required because this API runs outside Vercel (Render), which uses this token
# instead of OIDC. Same value on every environment sharing the store.
BLOB_READ_WRITE_TOKEN=

# Real Web Push delivery — generate once with the web-push library.
# These two values must MATCH between every environment that shares subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@blaupunktcar.in

# Seeding passwords — set to YOUR OWN values (not in repo; rotate periodically)
ADMIN_EMAIL=admin@blaupunktcar.in
ADMIN_PASSWORD=<your admin seed password>
TECH_DEFAULT_PASSWORD=<your engineer seed password>

# ── Backup recovery (Super Admin only) ───────────────────────────────
# Google Drive access — use the same service account as backup-cron.
# The key can be provided inline, as base64, as a file path, or as
# ./service-account.json (gitignored, auto-detected).
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
SHARED_DRIVE_ID=
SHARED_DRIVE_NAME=
DRIVE_ROOT_FOLDER_NAME=BPIN CRM Backups
# Minutes of inactivity before recovery re-authentication is required again
RECOVERY_SESSION_TTL_MINUTES=15
# Maximum size (MB) of a single media asset the recovery will restore
RECOVERY_MAX_ASSET_MB=100
# Test/dev only — local mirrors so destructive drills never touch production
# DRIVE_LOCAL_DIR=
# BLOB_LOCAL_DIR=
# RECOVERY_TEST_FAULTS=
